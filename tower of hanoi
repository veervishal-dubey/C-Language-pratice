#include <stdio.h>

void towerofhanoi(int num, char source, char intermediate, char destination)
{
    if (num==1)
    {
        printf("Move disk from %c to %c",source, destination);
    }
    else
    {
        towerofhanoi(num-1, source, destination, intermediate);
        printf("Move disk from %c to %c",source, destination);
        towerofhanoi(num-1,intermediate,source,destination);
    }
}
int main()
{
    int n=5;
    towerofhanoi(n,'S','I','D');
    return 0;
}
