#include <stdio.h>

int queue[5];
int front=-1;
int rear=-1;

void enqueue(int arr[],int element)
{
    if (front==(rear+1)%5)
    {
        printf("Cannot enqueue. The queue will overflow.");
    }
    else if (front==-1)
    {
        front=0;
        rear=0;
        arr[rear]=element;
    }
    else
    {
        rear=(rear+1)%5;
        arr[rear]=element;
    }
}

int dequeue(int arr[]){
    if (front==-1)
    {
        printf("Cannot dequeue, the queue will underflow.");
        return -1;
    }
    else if (front==rear)
    {
        int value=arr[front];
        front = rear = -1;
        return value;
    }
    else
    {
        int value = arr[front];
        front=(front+1)%5;
        return value;
    }
}

void display()
{   
    if (front==-1)
    {
        printf("The queue is empty.\n");
    }
    else
    {   printf("printing queue from the front: \n");
        int i=front;
        for (i;;i=(i+1)%5)
        {
            printf("%d \t",queue[i]);
            if (i==rear)
            {   
                printf("\n");
                break;
            }
        }
        printf("End of queue. \n");
    }
}

int main() {
    enqueue(queue, 10);
    enqueue(queue, 20);
    enqueue(queue, 30);
    enqueue(queue, 40);
    enqueue(queue, 50);  

    display();

    printf("Dequeued: %d\n", dequeue(queue));
    printf("Dequeued: %d\n", dequeue(queue));

    display();

    enqueue(queue, 60);
    enqueue(queue, 70);  

    display();

    return 0;
}

