#include <stdio.h>
#include <ctype.h>
#include <string.h>

#define SIZE 100

int top = -1;
char stack[SIZE];

// Push an element onto the stack
void push(char arr[], char element) {
    if (top < SIZE - 1) {
        arr[++top] = element;
    } else {
        printf("Stack Overflow\n");
    }
}

// Pop an element from the stack
char pop(char arr[]) {
    if (top >= 0) {
        return arr[top--];
    } else {
        printf("Stack Underflow\n");
        return '\0';
    }
}

// Stack precedence of operators
int stackprecedence(char symbol) {
    switch (symbol) {
        case '+': case '-': return 1;
        case '*': case '/': return 3;
        case '^': return 6;
        case '(': return 0;
        case '#': return -1;
        default: return 8;
    }
}

// Input precedence of operators
int inputprecedence(char symbol) {
    switch (symbol) {
        case '+': case '-': return 2;
        case '*': case '/': return 4;
        case '^': return 5;
        case '(': return 9;
        case ')': return 0;
        default: return 7;
    }
}

// Reverse a string in-place
void reverse(char* str) {
    int len = strlen(str);
    for (int i = 0; i < len / 2; i++) {
        char temp = str[i];
        str[i] = str[len - i - 1];
        str[len - i - 1] = temp;
    }
}

// Convert infix to prefix
void infixtoprefix(char infix[], char stack[]) {
    top = -1; // Reset stack
    push(stack, '#');

    reverse(infix);

    // Swap parentheses after reversal
    for (int k = 0; infix[k] != '\0'; k++) {
        if (infix[k] == '(') infix[k] = ')';
        else if (infix[k] == ')') infix[k] = '(';
    }

    char fix[SIZE], prefix[SIZE];
    int i = 0, j = 0;
    char symbol;

    while (infix[i] != '\0') {
        symbol = infix[i];

        if (isalnum(symbol)) {
            fix[j++] = symbol;
        } else if (symbol == '(') {
            push(stack, symbol);
        } else if (symbol == ')') {
            while (top != -1 && stack[top] != '(') {
                fix[j++] = pop(stack);
            }
            if (top != -1 && stack[top] == '(') {
                pop(stack); // remove '('
            }
        } else {
            while (top != -1 && stackprecedence(stack[top]) > inputprecedence(symbol)) {
                fix[j++] = pop(stack);
            }
            push(stack, symbol);
        }
        i++;
    }

    while (top != -1 && stack[top] != '#') {
        fix[j++] = pop(stack);
    }

    fix[j] = '\0';
    reverse(fix);
    strcpy(prefix, fix);
    printf("The prefix expression is: %s\n", prefix);
}

// Main function
int main() {
    char original[] = "(A+B)*(C-D)/E";
    infixtoprefix(original, stack);
    return 0;
}
